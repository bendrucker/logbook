{
  "name": "logbook",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "backfill": "bun scripts/backfill.ts",
    "test": "vitest run",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "types": "wrangler types",
    "dev": "wrangler dev",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "hyparquet-writer": "^0.16.10",
    "instapaper-api": "1.0.0",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/bun": "^1.4.2",
    "hyparquet": "^1.31.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  }
}
