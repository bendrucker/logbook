{
  "name": "logbook",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit && tsc -p workers/monitor --noEmit",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "backfill": "bun scripts/backfill.ts",
    "import:apple-music": "bun scripts/import-apple-music.ts",
    "trakt:login": "bun scripts/trakt-login.ts",
    "monitor:trakt-login": "bun scripts/monitor-trakt-login.ts",
    "test": "vitest run && vitest run --config workers/monitor/vitest.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "types": "wrangler types && wrangler types --config workers/monitor/wrangler.jsonc workers/monitor/worker-configuration.d.ts",
    "dev": "wrangler dev",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "hyparquet-writer": "^0.16.12",
    "instapaper-api": "1.0.0",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@types/bun": "^1.4.3",
    "hyparquet": "^1.31.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
