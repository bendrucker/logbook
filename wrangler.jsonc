{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logbook",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // Pinned so CI only needs CLOUDFLARE_API_TOKEN. Not a secret.
  "account_id": "72bdc77341dc52a3cf4a94097f9ad96f",
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Public identifier rather than a secret. The token that reads GitHub is a
    // Worker secret. Whose history it reads is not.
    "GITHUB_LOGIN": "bendrucker",
    // Months a single POST /admin/backfill call walks. Each window is a search
    // page plus its R2 write and its D1 writes, far short of the 10,000
    // subrequests a paid invocation gets. The walk is paged to stay inside the
    // wall clock rather than a platform ceiling.
    "BACKFILL_WINDOWS": 12,
  },
  "triggers": {
    // Hourly incremental sync. GitHub's search API is windowed by date rather
    // than by event, so a missed run costs nothing but a wider next window.
    //
    // The nightly lake build sits off the hour so it never shares an instant
    // with a sync invocation. `LAKE_CRON` is the expression it dispatches on.
    "crons": ["0 * * * *", "30 9 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      // The database predates the rename to Logbook. D1 cannot rename a
      // database, and the ID is what binds, so the old name stays.
      "database_name": "code-hub",
      "database_id": "6d2d6371-265e-41d9-a075-247a7bc68859",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "logbook-raw" },
    // Shared with activity-hub so one DuckDB session can join rides against
    // pull requests. This project writes under a `github/` prefix.
    { "binding": "LAKE", "bucket_name": "activity-hub-lake" },
  ],
}
