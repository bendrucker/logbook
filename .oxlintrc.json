{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Copied from bendrucker/claude's `lint/`, so a change to either layer belongs there first.
  "extends": ["./lint/base.json", "./lint/typescript.json"],
  "ignorePatterns": ["worker-configuration.d.ts", ".wrangler/", "tmp/"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // `__typename` is GraphQL's own meta field, so the name is GitHub's.
    "no-underscore-dangle": ["error", { "allow": ["__typename"] }],
    // Error names are literals the site branches on across the service binding,
    // so the rule's `name` and `Error`-suffix demands would rename them.
    "unicorn/custom-error-definition": "off"
  },
  "overrides": [
    {
      // Test helpers live in the describe block they serve, and awaiting a
      // seed per row costs nothing a test notices.
      "files": ["**/*.test.ts", "test/**"],
      "rules": {
        "no-await-in-loop": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
