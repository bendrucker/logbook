{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "logbook-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // Pinned so CI only needs CLOUDFLARE_API_TOKEN. Not a secret.
  "account_id": "72bdc77341dc52a3cf4a94097f9ad96f",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "triggers": {
    // Hourly, between the sync at :17 and the next one, so a probe never reads
    // the lake mid-build. The nightly build lands around 09:30.
    "crons": ["47 * * * *"],
  },
  "vars": {
    // Whose history the content probe reads, the same public identifiers the
    // pipeline's own config names.
    "GITHUB_LOGIN": "bendrucker",
    "TRAKT_USER": "bendrucker",
    // The monitor's own Trakt application, apart from the pipeline's, so a
    // revoked grant in one can't blind the other. Its secret is a Worker secret.
    "TRAKT_CLIENT_ID": "nmJ1tcJ_TIpoxVhlhTcahD3851pQs2tUR1CCRxwJUaA",
    // What the monitor alerts on, kept apart from what it measures. A rule
    // opens once its last `for` samples of `metric` all cross `above` or
    // `below`, and sends the incident to `route`. Every rule starts on `log`.
    "ALERT_RULES": [
      // The nightly build rewrites every table, so a day and two hours is a
      // build that didn't land.
      {
        "name": "lake-stale",
        "metric": "lake.age_seconds",
        "above": 93600,
        "for": 2,
        "route": "log",
      },
      // Something upstream has been missing from the lake for longer than a
      // nightly build plus an hourly sync can explain.
      {
        "name": "content-lag",
        "metric": "content.lag_seconds",
        "above": 93600,
        "for": 2,
        "route": "log",
      },
      // A prefix with no tables is a source the build stopped writing.
      {
        "name": "lake-source-empty",
        "metric": "lake.tables",
        "below": 1,
        "for": 2,
        "route": "log",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logbook-monitor",
      "database_id": "2343f150-97c8-42c9-afd9-1928f690cdd3",
      "migrations_dir": "migrations",
    },
  ],
  // A copy of every metric for Cloudflare's Custom Alerts, which query
  // Analytics Engine with SQL. D1 stays the record the rules above read.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "logbook_monitor_metrics" }],
  "r2_buckets": [
    // Read only, by convention: the monitor lists objects and never writes.
    { "binding": "LAKE", "bucket_name": "activity-hub-lake" },
  ],
}
